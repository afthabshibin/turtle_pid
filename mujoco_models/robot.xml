<mujoco model="planar_robot">
    <option timestep="0.002"/>
    <statistic center="5.54 5.54 0" extent="12"/>
    <visual>
        <global azimuth="90" elevation="-90"/>
    </visual>

    <worldbody>
        <light pos="5.54 5.54 12" dir="0 0 -1"/>
        <geom name="floor" type="plane" pos="5.54 5.54 0" size="6 6 0.1" rgba="0.85 0.85 0.85 1"/>
        <geom name="wall_n" type="box" pos="5.54 11.14 0.15" size="5.64 0.1 0.15" rgba="0.4 0.4 0.4 1"/>
        <geom name="wall_s" type="box" pos="5.54 -0.06 0.15" size="5.64 0.1 0.15" rgba="0.4 0.4 0.4 1"/>
        <geom name="wall_e" type="box" pos="11.14 5.54 0.15" size="0.1 5.64 0.15" rgba="0.4 0.4 0.4 1"/>
        <geom name="wall_w" type="box" pos="-0.06 5.54 0.15" size="0.1 5.64 0.15" rgba="0.4 0.4 0.4 1"/>

        <body name="robot" pos="0 0 0.1">
            <joint name="slide_x" type="slide" axis="1 0 0" damping="2"/>
            <joint name="slide_y" type="slide" axis="0 1 0" damping="2"/>
            <joint name="turn" type="hinge" axis="0 0 1" damping="1"/>
            <geom name="body" type="box" size="0.25 0.15 0.08" mass="1" rgba="0.2 0.4 0.9 1"/>
            <geom name="nose" type="sphere" size="0.06" pos="0.25 0 0" rgba="1 0.3 0.2 1"/>
        </body>
    </worldbody>
    <actuator>
        <motor name="force_x" joint="slide_x" gear="1" ctrlrange="-20 20"/>
        <motor name="force_y" joint="slide_y" gear="1" ctrlrange="-20 20"/>
        <motor name="torque_turn" joint="turn" gear="1" ctrlrange="-5 5"/>
    </actuator>
</mujoco>